# ---------------------------------------------------------------------------
# SecureCV environment variables. Copy to .env.local and fill in.
# ---------------------------------------------------------------------------

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional: search console ownership verification (content value of the meta tag only).
#   Google: https://search.google.com/search-console  Bing: https://www.bing.com/webmasters
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Database: Turso (libSQL) — https://turso.tech (free tier: 5 GB, no inactivity pausing)
#   turso db create securecv --location bom   # Mumbai, close to Vercel bom1
#   turso db show securecv --url
#   turso db tokens create securecv
# Leave both empty in local dev to use a SQLite file at ./.data/securecv.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Auth: Auth.js v5 — https://authjs.dev
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: https://securecv.co.in/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub: https://github.com/settings/developers
#   Callback URL: https://securecv.co.in/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- AI (resume rewrite + import) ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# ENABLE_AI_REWRITER=true

# --- Fresher jobs board (/jobs) ---
# Protects /api/cron/jobs; Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=
# Adzuna (free key): https://developer.adzuna.com/ — main source of private-sector fresher jobs in India
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Optional: public ATS job boards of companies hiring freshers in India (comma separated slug[:Display Name]).
# Verify each slug first: https://boards-api.greenhouse.io/v1/boards/<slug>/jobs and https://api.lever.co/v0/postings/<slug>
GREENHOUSE_BOARDS=
LEVER_COMPANIES=
# Optional: RSS/Atom feeds, separated by ';' as sector|Name|URL (sector = government or private)
# e.g. JOB_FEEDS=government|Some Commission|https://example.gov.in/recruitment.rss
JOB_FEEDS=
# JOBS_RETENTION_DAYS=21
# Optional: IndexNow key (8-128 chars, letters/digits/dashes). When set, the monthly cron pings
# Bing/Yandex with new job URLs; the key is served at /indexnow-key.txt. Generate with `openssl rand -hex 16`.
# INDEXNOW_KEY=

# --- One-time migration from Supabase (scripts/migrate-from-supabase.ts) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Observability (optional) ---
# LOG_LEVEL=info
# NEW_RELIC_LICENSE_KEY=
